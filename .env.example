# Mẫu biến môi trường cho Quiz Study.
# Sao chép thành file .env rồi điền giá trị thật. KHÔNG commit file .env (đã có trong .gitignore).

# --- Kết nối database cho backend PHP chạy trên máy (backend-php/dev-router.php) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz_study
DB_USERNAME=quiz_app
# Để trống: scripts/setup-database.ps1 sẽ tự sinh mật khẩu ngẫu nhiên và ghi vào .env.
DB_PASSWORD=

# --- Quản trị: migration và import môn (scripts/admin.mjs, D-056) ---
# Mã quản trị của server PHP chạy trên máy (backend-php/dev-router.php), ít nhất 24 ký tự. Tạo mã:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# Server mà scripts/admin.mjs gửi lệnh tới. Để trống: server trên máy (http://127.0.0.1:8080).
# Hosting: https://<tên miền>, kèm QUIZ_ADMIN_TOKEN = admin_token trong api/config.php trên hosting.
QUIZ_ADMIN_URL=
# Để trống: dùng ADMIN_TOKEN ở trên.
QUIZ_ADMIN_TOKEN=

# --- Chỉ dùng khi chạy MySQL bằng docker-compose.yml ---
MYSQL_ROOT_PASSWORD=
DB_DOCKER_PORT=3307
